{
  "name": "@grok-build/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser client for `grok agent gateway`: the session roster grouped by working directory, one session's transcript, and plugin panels.",
  "scripts": {
    "build": "bun build src/main.ts --outfile public/bundle.js --target browser",
    "serve": "bun run scripts/serve.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.3.10",
    "typescript": "^5.6.3"
  }
}
