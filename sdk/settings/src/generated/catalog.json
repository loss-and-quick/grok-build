      "key": "permission_mode",
      "category": "agent",
      "owner": "shell",
      "surface": "any",
      "label": "Permission mode",
      "description": "Default uses the agent's built-in behavior; Ask prompts for each tool action; Auto uses an LLM classifier for risky tools; Always approve grants all permissions automatically.",
      "keywords": [
        "permission",
        "approve",
        "yolo",
        "agent",
        "always",
        "ask",
        "auto",
        "classifier",
        "tool",
        "danger"
      ],
      "kind": {
        "type": "enum",
        "default": "ask",
        "choices": [
          {
            "canonical": "default",
            "display": "Default",
            "description": "Use the agent's default permission behavior (currently equivalent to Ask)."
          },
          {
            "canonical": "ask",
            "display": "Ask",
            "description": "Prompt for permission before tool actions."
          },
          {
            "canonical": "auto",
            "display": "Auto",
            "description": "LLM classifier approves safe tools; dangerous actions may still prompt or deny."
          },
          {
            "canonical": "always-approve",
            "display": "Always approve",
